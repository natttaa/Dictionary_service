{
  "uid": "dictionary-services",
  "title": "Dictionary services",
  "tags": ["dictionary", "go"],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 4,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Доступность сервисов",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=~\"service1|service2\"}", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "Недоступен", "color": "red"}, "1": {"text": "Работает", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 2,
      "title": "Запросов в секунду",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 7},
      "targets": [{"expr": "sum by (job) (rate(dictionary_http_requests_total{job=~\"service1|service2\"}[$__rate_interval]))", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "title": "Ошибки HTTP с запуска (4xx и 5xx)",
      "description": "Накопленное число ошибок с момента запуска каждого сервиса. Счётчик сбрасывается при перезапуске сервиса.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 7},
      "targets": [{"expr": "sum by (job) (dictionary_http_requests_total{job=~\"service1|service2\",status=~\"4..|5..\"})", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "title": "Среднее время ответа",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 16},
      "targets": [{"expr": "sum by (job) (rate(dictionary_http_request_duration_seconds_sum{job=~\"service1|service2\"}[$__rate_interval])) / sum by (job) (rate(dictionary_http_request_duration_seconds_count{job=~\"service1|service2\"}[$__rate_interval]))", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "title": "HTTP-ответы по кодам с запуска",
      "description": "Накопленное число ответов API по HTTP-кодам. Проверки /health не учитываются.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 16},
      "targets": [{"expr": "sum by (job, status) (dictionary_http_requests_total{job=~\"service1|service2\",route!=\"/api/v1/health\"})", "legendFormat": "{{job}} {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "title": "Запросы по API-методам",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 25},
      "targets": [{"expr": "sum by (job, method, route) (rate(dictionary_http_requests_total{job=~\"service1|service2\",route!=\"/api/v1/health\"}[$__rate_interval]))", "legendFormat": "{{job}} {{method}} {{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7,
      "title": "Ошибки по API-методам с запуска",
      "description": "Накопленное число ответов 4xx и 5xx с момента запуска каждого сервиса. Счётчик сбрасывается при перезапуске сервиса.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 25},
      "targets": [{"expr": "sum by (job, method, route, status) (dictionary_http_requests_total{job=~\"service1|service2\",route!=\"/api/v1/health\",status=~\"4..|5..\"})", "legendFormat": "{{job}} {{method}} {{route}} {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 8,
      "title": "Доля ошибок по сервисам",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 34},
      "targets": [{"expr": "(sum by (job) (rate(dictionary_http_requests_total{job=~\"service1|service2\",route!=\"/api/v1/health\",status=~\"4..|5..\"}[$__rate_interval])) or on (job) (0 * sum by (job) (rate(dictionary_http_requests_total{job=~\"service1|service2\",route!=\"/api/v1/health\"}[$__rate_interval])))) / clamp_min(sum by (job) (rate(dictionary_http_requests_total{job=~\"service1|service2\",route!=\"/api/v1/health\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 9,
      "title": "Проверка цепочки сервисов и БД",
      "description": "service2-db проверяет service2 и PostgreSQL; service1-service2-db проверяет всю цепочку через service1.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 34},
      "targets": [{"expr": "probe_success{job=\"health\"}", "legendFormat": "{{component}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "Недоступна", "color": "red"}, "1": {"text": "Работает", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 10,
      "title": "Всего HTTP API и SQL-запросов с запуска",
      "description": "HTTP: без /health и /metrics. SQL: только запросы service2, без проверок подключения к БД. Значения сбрасываются при перезапуске сервисов.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 43},
      "targets": [
        {"expr": "sum by (job) (dictionary_http_requests_total{job=~\"service1|service2\",route!=\"/api/v1/health\"})", "legendFormat": "HTTP {{job}}", "refId": "A"},
        {"expr": "sum by (job) (dictionary_sql_queries_total{job=\"service2\"})", "legendFormat": "SQL {{job}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 11,
      "title": "SQL-запросы по операциям с запуска",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 51},
      "targets": [{"expr": "sum by (operation) (dictionary_sql_queries_total{job=\"service2\"})", "legendFormat": "{{operation}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 12,
      "title": "Средняя длительность SQL по операциям",
      "description": "Среднее с момента запуска service2, включая чтение строк результата.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 51},
      "targets": [{"expr": "sum by (operation) (dictionary_sql_query_duration_seconds_sum{job=\"service2\"}) / sum by (operation) (dictionary_sql_query_duration_seconds_count{job=\"service2\"})", "legendFormat": "{{operation}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 13,
      "title": "Результаты SQL по кодам с запуска",
      "description": "OK — успешный запрос, NO_ROWS — данных нет, OTHER — ошибка без SQLSTATE; остальные значения — SQLSTATE PostgreSQL.",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 60},
      "targets": [{"expr": "sum by (operation, code) (dictionary_sql_queries_total{job=\"service2\"})", "legendFormat": "{{operation}} {{code}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "decimals": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ]
}
