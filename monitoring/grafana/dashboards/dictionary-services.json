{
  "uid": "dictionary-services",
  "title": "Dictionary services",
  "tags": ["dictionary", "go"],
  "timezone": "browser",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Доступность сервисов",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=~\"service1|service2\"}", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "Недоступен", "color": "red"}, "1": {"text": "Работает", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 2,
      "title": "Запросов в секунду",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 14},
      "targets": [{"expr": "sum by (job) (rate(dictionary_http_requests_total{job=~\"service1|service2\"}[$__rate_interval]))", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 3,
      "title": "Ошибок HTTP в секунду (4xx и 5xx)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 14},
      "targets": [{"expr": "sum by (job) (rate(dictionary_http_requests_total{job=~\"service1|service2\",status=~\"4..|5..\"}[$__rate_interval]))", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 4,
      "title": "Среднее время ответа",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 23},
      "targets": [{"expr": "sum by (job) (rate(dictionary_http_request_duration_seconds_sum{job=~\"service1|service2\"}[$__rate_interval])) / sum by (job) (rate(dictionary_http_request_duration_seconds_count{job=~\"service1|service2\"}[$__rate_interval]))", "legendFormat": "{{job}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "title": "Ответы по HTTP-кодам",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 23},
      "targets": [{"expr": "sum by (job, status) (rate(dictionary_http_requests_total{job=~\"service1|service2\"}[$__rate_interval]))", "legendFormat": "{{job}} {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 6,
      "title": "Цепочка: сервис 1 → сервис 2 → БД",
      "description": "HTTP показывает доступность /metrics. Зависимости проверяются при каждом сборе метрик; 0 означает недоступность или ошибку проверки.",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 7, "w": 24, "x": 0, "y": 7},
      "targets": [
        {"expr": "up{job=\"service1\"}", "legendFormat": "Сервис 1 HTTP", "refId": "A", "instant": true},
        {"expr": "dictionary_dependency_up{job=\"service1\",dependency=\"service2\"} or on(job, instance) (up{job=\"service1\"} * 0)", "legendFormat": "Сервис 1 → сервис 2", "refId": "B", "instant": true},
        {"expr": "up{job=\"service2\"}", "legendFormat": "Сервис 2 HTTP", "refId": "C", "instant": true},
        {"expr": "dictionary_dependency_up{job=\"service2\",dependency=\"database\"} or on(job, instance) (up{job=\"service2\"} * 0)", "legendFormat": "Сервис 2 → БД", "refId": "D", "instant": true}
      ],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "mappings": [{"type": "value", "options": {"0": {"text": "Недоступен", "color": "red"}, "1": {"text": "Работает", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": "auto", "colorMode": "value", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 7,
      "title": "Запросы по API-методам",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 32},
      "targets": [{"expr": "sum by (job, method, route) (rate(dictionary_http_requests_total{job=~\"service1|service2\",route!=\"other\"}[$__rate_interval]))", "legendFormat": "{{job}} {{method}} {{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 8,
      "title": "Ошибки по API-методам (4xx и 5xx)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 32},
      "targets": [{"expr": "sum by (job, method, route, status) (rate(dictionary_http_requests_total{job=~\"service1|service2\",route!=\"other\",status=~\"4..|5..\"}[$__rate_interval]))", "legendFormat": "{{job}} {{method}} {{route}} {{status}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 9,
      "title": "Доля ошибок по API-методам",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "dictionary-prometheus"},
      "gridPos": {"h": 9, "w": 24, "x": 0, "y": 41},
      "targets": [{"expr": "100 * ((sum by (job, method, route) (rate(dictionary_http_requests_total{job=~\"service1|service2\",route!=\"other\",status=~\"4..|5..\"}[$__rate_interval])) or on (job, method, route) (0 * sum by (job, method, route) (rate(dictionary_http_requests_total{job=~\"service1|service2\",route!=\"other\"}[$__rate_interval])))) / clamp_min(sum by (job, method, route) (rate(dictionary_http_requests_total{job=~\"service1|service2\",route!=\"other\"}[$__rate_interval])), 1e-9)", "legendFormat": "{{job}} {{method}} {{route}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ]
}
